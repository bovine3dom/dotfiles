#!/usr/bin/env bash

set -euo pipefail

if [[ $(uname -s) != Linux || ! -x /usr/bin/pacman ]]; then
  printf 'This bootstrap currently supports Arch Linux only.\n' >&2
  exit 1
fi

packages=(
  bat
  bspwm
  curl
  difftastic
  elinks
  feh
  firefox
  fish
  fisher
  fontconfig
  fzf
  git
  git-lfs
  glances
  gnupg
  i3-wm
  julia
  keychain
  neovim
  noto-fonts
  npm
  openssh
  polybar
  python
  python-pip
  ripgrep
  surfraw
  sxhkd
  task
  tmux
  ttf-liberation
  ttf-opensans
  vim
  wget
  xdotool
  xorg-server
  xorg-xinit
  xorg-xrandr
  xorg-xset
  yadm
)

sudo pacman -Syu --needed "${packages[@]}"

if command -v paru >/dev/null; then
  paru -S --needed ttf-iosevka-term
else
  printf 'paru is unavailable; skipping the Iosevka Term AUR package.\n' >&2
fi

mkdir -p "$HOME/.undodir" "$HOME/.vim/autoload"

plug="$HOME/.vim/autoload/plug.vim"
if [[ ! -f $plug ]]; then
  curl --fail --location \
    https://raw.githubusercontent.com/junegunn/vim-plug/0.14.0/plug.vim \
    --output "$plug"
fi

fish -c 'fisher update'
vim +"PlugInstall --sync" +qa
