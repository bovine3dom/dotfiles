[user]
	name = Oliver Blanthorn
	email = freedom4cows@gmail.com
    signingKey = Blanthorn
[push]
    default = simple
    followTags = true
[core]
    editor = vim
[color]
    status = auto
    branch = auto
    interactive = auto
    diff = auto
    ui = auto
[core]
    excludesfile = ~/.gitignore
	; pager = diff-so-fancy | less --tabs=4 -RFX
[diff]
	; tool = icdiff
    ; algorithm = histogram
    external = difft
    tool = difftastic
[pager]
    difftool = true
[difftool]
    prompt = false
; [difftool "icdiff"]
;     cmd = icdiff --line-numbers $LOCAL $REMOTE
; [difftool "difftastic"]
;     cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"
[log]
    decorate = auto
    date = relative
    graph = true
[merge]
    tool = vimdiff
    conflictstyle = diff3
    prompt = false
; [merge "mergiraf"] ; doesn't seem to work automatically :(
;     name = mergiraf
;     driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
[alias]
    nicelog = "log --graph --abbrev-commit --stat"
    loggraph = "log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'"
    lg2-specific = "log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(auto)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'"
    lg3-specific = "log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset) %C(bold cyan)(committed: %cD)%C(reset) %C(auto)%d%C(reset)%n''          %C(white)%s%C(reset)%n''          %C(dim white)- %an <%ae> %C(reset) %C(dim white)(committer: %cn <%ce>)%C(reset)'"
    innit = init
[commit]
    gpgSign = true
[url "git@github.com:"]
    pushInsteadOf = "https://github.com/"
    pushInsteadOf = "git://github.com/"
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[pull]
	rebase = false
